{
    "id": "vscode-terraform",
    "version": "1.0.2",
    "name": "VS Code Terraform extensions",
    "description": "Terraform開発用のVS Code拡張機能を追加します。許可リスト(extensions.allowed)は vscode-common Feature が提供するため、必ず併用してください。",
    "documentationURL": "https://github.com/Diiva-Szk/devcontainer-env-core/tree/main/devcontainer-features/vscode-terraform",
    "installsAfter": [
        "ghcr.io/diiva-szk/devcontainer-env-core/vscode-common"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                // renovate: datasource=github-releases depName=hashicorp/vscode-terraform
                "hashicorp.terraform@2.40.0"
            ]
        }
    }
}
