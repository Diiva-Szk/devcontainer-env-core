#!/bin/bash
###########################################################################
# git-sign-1password
#   git の SSH 署名（gpg.ssh.program）から呼ばれ、1Password の SSH エージェントで署名する。
#   setup-git-signing が、1Password で署名する設定のときに gpg.ssh.program に設定する。
#
#   user.signingkey には公開鍵のファイルを設定している。ssh-keygen -Y sign は、-f に公開鍵を
#   渡すと、秘密鍵を ssh-agent（SSH_AUTH_SOCK）に求める。
#   SSH_AUTH_SOCK をコンテナ全体には設定しない。設定すると ssh の接続（git fetch など）でも
#   1Password の鍵が使われ、そのたびに承認を求められるため。署名のときだけ、ここで
#   1Password のエージェントを指す。
#   署名の検証（git log --show-signature など）でも呼ばれるが、その場合エージェントは使われない。
###########################################################################
export SSH_AUTH_SOCK="${HOME}/.1password/agent.sock"
exec ssh-keygen "$@"
