#!/bin/bash
###########################################################################
# 1password（ai 用のラッパー）
#   1Password のデスクトップアプリ（/opt/1Password。Dockerfile で tar.gz から導入）を、
#   コンテナで必要な起動オプションを付けて起動する。git の署名を 1Password で行う設定のときは、
#   デスクトップ（~/.config/openbox/autostart）が自動で起動する。
#
#   --no-sandbox:            chrome-sandbox に SUID を付けておらず、コンテナでは user namespace も
#                            使えないため（Google Chrome のラッパーと同じ）。
#   --disable-dev-shm-usage: コンテナの /dev/shm は小さいため（Google Chrome のラッパーと同じ）。
#   --disable-gpu:           GPU が無いため（Google Chrome のラッパーと同じ）。
###########################################################################
exec /opt/1Password/1password \
  --no-sandbox \
  --disable-dev-shm-usage \
  --disable-gpu \
  "$@"
