#!/bin/bash
###########################################################################
# google-chrome
#   Google Chrome を ai コンテナ用の起動オプション付きで起動するラッパー。
#   Chrome には Debian の Chromium（/etc/chromium.d/）のような起動オプションの設定ファイルが
#   無いため、このラッパーで付ける。/usr/bin/google-chrome-stable もこのラッパーを指す
#   （Dockerfile で dpkg-divert している）ため、デスクトップのアイコン・AI エージェント・
#   ai コンテナのシェル・xdg-open のどこから起動しても同じ設定になる。
#   dev-base の共通のラッパー（docker-images/dev-base/usr/local/bin/google-chrome）を
#   ai ステージで置き換えたもの。共通の起動オプションを変えるときは両方を合わせる。
#
#   --no-sandbox / --test-type:
#     コンテナ内では Chrome のサンドボックスを作れない（user namespace 等の権限が無い）ため無効にする。
#     --test-type は --no-sandbox の警告バーを出さないためのもの。
#   --remote-debugging-*:
#     AI エージェント（Antigravity 等）が DevTools Protocol でブラウザを操作するため。
#     コンテナの外からは接続させないよう 127.0.0.1 で待ち受ける。
#     既定のプロファイルではリモートデバッグが無効になるため、専用の user-data-dir を使う。
#   --disable-dev-shm-usage: コンテナの /dev/shm は小さい（既定 64MB）ため /tmp を使わせる。
###########################################################################
exec /opt/google/chrome/google-chrome \
  --no-sandbox \
  --test-type \
  --no-first-run \
  --no-default-browser-check \
  --password-store=basic \
  --disable-dev-shm-usage \
  --disable-gpu \
  --disable-features=Translate \
  --remote-debugging-address=127.0.0.1 \
  --remote-debugging-port=9222 \
  --user-data-dir="${HOME}/.config/google-chrome-ai" \
  "$@"
