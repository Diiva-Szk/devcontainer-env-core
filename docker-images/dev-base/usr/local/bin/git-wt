#!/usr/bin/env bash
###########################################################################
# git-wt
#   メインの worktree 直下の .worktrees/ に git worktree を作成・削除する（ai / user 共通）。
#   mise のタスク（wt:add / wt:rm / wt:list）と、ai コンテナの agent-wt（dagu の DAG）から呼ぶ。
#   PATH 上の git-<名前> は git のサブコマンドになるため、git wt add ... とも書ける。
#
#   実行したディレクトリによらず、メインの worktree のルートを基準にする
#   （worktree の中で実行しても同じ .worktrees を使い、サブモジュールの中ではサブモジュールの
#   .worktrees を使う。git worktree list の先頭はサブモジュールだと .git/modules を指すため使わない）。
###########################################################################
set -euo pipefail

usage() {
  cat <<'EOF'
使い方:
  git-wt add [-b <base>] [--name <dir>] <branch>
      .worktrees/<dir>（既定: <branch>）に worktree を作る。
      ブランチはローカル → origin/<branch>（追跡するブランチを作る）→ <base>（既定: main）から
      新しく作る、の順で決める。-b はブランチを新しく作るときだけ使う。

  git-wt rm [-f] [--keep-branch] [--name <dir>] [<branch>]
      .worktrees/<dir>（既定: <branch>）の worktree とブランチを削除する。
      未コミットの変更か未マージのコミット（upstream、無ければ HEAD に入っていない）があれば、
      何も削除せずに止まる。-f で強制的に削除する。worktree が既に無ければブランチだけを削除する。
      --keep-branch のときはブランチを残し、worktree だけを削除する（<branch> は不要）。

  git-wt list
      worktree の一覧を表示する（git worktree list）。
EOF
}

die() {
  echo "git-wt: $*" >&2
  exit 1
}

# .worktrees/ の下のディレクトリ名として安全か（絶対パス・.. ・空の要素を拒否する）
check_dir() {
  local dir="$1" part
  local -a parts
  [[ -n "${dir}" && "${dir}" != /* && "${dir}" != */ && "${dir}" != -* ]] \
    || die "worktree のディレクトリ名に使えません: '${dir}'"
  IFS=/ read -ra parts <<< "${dir}"
  for part in "${parts[@]}"; do
    [[ -n "${part}" && "${part}" != . && "${part}" != .. ]] \
      || die "worktree のディレクトリ名に使えません: '${dir}'"
  done
}

# メインの worktree のルートへ移動する。
#   代入してから cd する（cd "$(...)" だと置換の中の失敗で set -e が働かず、
#   cd "" で実行したディレクトリに留まったまま続行してしまう）。
#   メインの worktree が無い構成（bare + worktree）は rev-parse が失敗して止まる。
cd_main_root() {
  local common top
  common="$(git rev-parse --path-format=absolute --git-common-dir)"
  top="$(cd "${common}/.." && git --git-dir="${common}" rev-parse --show-toplevel)"
  cd "${top}"
}

cmd_add() {
  local base=main name="" branch=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -b | --base) [ $# -ge 2 ] || die "$1 に値がありません"; base="$2"; shift 2 ;;
      --name) [ $# -ge 2 ] || die "$1 に値がありません"; name="$2"; shift 2 ;;
      -h | --help) usage; exit 0 ;;
      --) shift; break ;;
      -*) die "不明なオプション: $1" ;;
      *) break ;;
    esac
  done
  [ $# -eq 1 ] || { usage >&2; exit 2; }
  branch="$1"
  [[ "${base}" != -* ]] || die "分岐元に使えません: '${base}'"

  cd_main_root
  git check-ref-format --branch "${branch}" > /dev/null
  local dir="${name:-${branch}}"
  check_dir "${dir}"
  local path=".worktrees/${dir}"

  if git show-ref --verify --quiet "refs/heads/${branch}"; then
    git worktree add "${path}" "${branch}"
  elif git show-ref --verify --quiet "refs/remotes/origin/${branch}"; then
    # origin にだけあるブランチは、それを追跡するブランチを作る（素の git worktree add と同じ動作）
    git worktree add --track -b "${branch}" "${path}" "origin/${branch}"
  else
    git worktree add -b "${branch}" "${path}" "${base}"
  fi
}

cmd_rm() {
  local force=false keep=false name="" branch=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -f | --force) force=true; shift ;;
      --keep-branch) keep=true; shift ;;
      --name) [ $# -ge 2 ] || die "$1 に値がありません"; name="$2"; shift 2 ;;
      -h | --help) usage; exit 0 ;;
      --) shift; break ;;
      -*) die "不明なオプション: $1" ;;
      *) break ;;
    esac
  done
  [ $# -le 1 ] || { usage >&2; exit 2; }
  branch="${1:-}"
  [ "${keep}" = true ] || [ -n "${branch}" ] || die "ブランチ名を指定してください（ブランチを残すときは --keep-branch）"

  cd_main_root
  local dir="${name:-${branch}}"
  [ -n "${dir}" ] || die "ブランチ名か --name を指定してください"
  check_dir "${dir}"
  local path=".worktrees/${dir}"

  if [ "${keep}" = true ]; then
    [ -e "${path}" ] || die "worktree がありません: ${path}"
  else
    git show-ref --verify --quiet "refs/heads/${branch}" || die "ブランチ '${branch}' がありません"
    # 別のブランチの worktree を消してしまわないよう、worktree のブランチと一致するか確かめる
    if [ -e "${path}" ]; then
      local current
      current="$(git -C "${path}" symbolic-ref --quiet --short HEAD || true)"
      [ "${current}" = "${branch}" ] \
        || die "'${path}' のブランチは '${current:-（detached HEAD）}' で、'${branch}' ではありません"
    fi
    if [ "${force}" != true ]; then
      # worktree を消す前に、git branch -d と同じ基準（upstream、無ければ HEAD）でマージ済みか確かめる。
      # 後から branch -d で止まると、worktree だけが消えた状態になるため
      local target
      target="$(git rev-parse --verify --quiet "${branch}@{upstream}" || git rev-parse HEAD)"
      git merge-base --is-ancestor "refs/heads/${branch}" "${target}" \
        || die "ブランチ '${branch}' には未マージのコミットがあります（-f で強制的に削除できます）"
    fi
  fi

  # worktree が既に無い場合（手で消した・前回の実行が途中で止まったなど）は、ブランチの削除から続ける
  if [ -e "${path}" ]; then
    if [ "${force}" = true ]; then
      git worktree remove --force "${path}"
    else
      git worktree remove "${path}"
    fi
  fi
  # 登録だけ残った worktree があると branch -d/-D が拒否するため、片付けてから消す
  git worktree prune

  if [ "${keep}" != true ]; then
    if [ "${force}" = true ]; then
      git branch -D "${branch}"
    else
      git branch -d "${branch}"
    fi
  fi

  # 空になった親ディレクトリ（feat/ など）を消す。.worktrees 自体は残す
  local parent
  parent="$(dirname "${dir}")"
  if [ "${parent}" != "." ] && [ -d ".worktrees/${parent}" ]; then
    (cd .worktrees && rmdir -p --ignore-fail-on-non-empty "${parent}")
  fi
}

[ $# -ge 1 ] || { usage >&2; exit 2; }
sub="$1"
shift
case "${sub}" in
  add) cmd_add "$@" ;;
  rm | remove) cmd_rm "$@" ;;
  list | ls) git worktree list "$@" ;;
  -h | --help | help) usage ;;
  *) usage >&2; exit 2 ;;
esac
